# Application
APP_ENV=development

# Frontend
FRONTEND_URL=http://localhost:3000

# Backend
BACKEND_URL=http://localhost:8000
MEDISCRIBE_PROVIDER=local
MEDISCRIBE_LOCAL_MODE=mock
MEDISCRIBE_LANGUAGE=bs
MEDISCRIBE_WHISPER_CPP_BINARY=.runtime/whisper.cpp/build/bin/whisper-cli
MEDISCRIBE_WHISPER_LIVE_MODEL=.runtime/whisper.cpp/models/ggml-small-q5_1.bin
MEDISCRIBE_WHISPER_FINAL_MODEL=.runtime/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin
# Enable only after verifying cooling and running the host-side backend (not
# the lightweight Docker bridge). At most one local decode is launched.
MEDISCRIBE_LOCAL_TRANSCRIPTION_ENABLED=false
MEDISCRIBE_LOCAL_THREADS=
MEDISCRIBE_LOCAL_PYTHON=python
MEDISCRIBE_FFMPEG_BINARY=ffmpeg

# Optional external OpenRouter path. Do not commit a real key.
OPENROUTER_API_KEY=
MEDISCRIBE_ALLOW_REMOTE_PROCESSING=false
# "synthetic" permits only non-patient test recordings. "clinical" fails
# closed unless EU in-region routing and a signed processor agreement are set.
MEDISCRIBE_CLOUD_DATA_CLASSIFICATION=synthetic
MEDISCRIBE_OPENROUTER_EU_ONLY=false
MEDISCRIBE_OPENROUTER_DPA_APPROVED=false
# Pick `mai` (MAI Transcribe 2) or `whisper` (Whisper Large v3). Leave blank
# to require an explicit command-line choice.
MEDISCRIBE_OPENROUTER_STT_PROFILE=
# An explicit current OpenRouter model ID may be used instead of a profile.
MEDISCRIBE_OPENROUTER_TRANSCRIPTION_MODEL=
MEDISCRIBE_OPENROUTER_DRAFT_MODEL=anthropic/claude-sonnet-5

# Supabase is the optional persistent store. Keep all keys server-side. The
# service-role key must never be placed in the Electron renderer.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The clinician rows are owned by, until real sign-in exists. Leave any of
# SUPABASE_URL, the service-role key, or this blank and the app keeps every
# note in memory instead.
MEDISCRIBE_CLINICIAN_EMAIL=

# Draft note model. `local` mode writes the note on this machine with Ollama
# when it is running; without it the draft is the deterministic structure and
# the clinician writes the assessment. `hybrid` and `cloud` use OpenRouter.
MEDISCRIBE_OLLAMA_URL=http://127.0.0.1:11434
# Leave blank to use the first model Ollama reports.
MEDISCRIBE_OLLAMA_MODEL=
