# Browser bridge: keep this file untracked after copying it to backend/.env.
PORT=3001
FRONTEND_URL=http://localhost:5173

# Optional OpenRouter transcription. The server refuses requests until both
# this key and explicit per-recording approval are present.
OPENROUTER_API_KEY=
MEDISCRIBE_ALLOW_REMOTE_PROCESSING=false
MEDISCRIBE_CLOUD_DATA_CLASSIFICATION=synthetic
MEDISCRIBE_OPENROUTER_EU_ONLY=false
MEDISCRIBE_OPENROUTER_DPA_APPROVED=false
# Pick mai or whisper, or provide an approved explicit model ID instead.
MEDISCRIBE_OPENROUTER_STT_PROFILE=mai
MEDISCRIBE_OPENROUTER_TRANSCRIPTION_MODEL=

# Optional Supabase persistence. Do not expose the service-role key to Electron.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
