# Groq API ključ (za transkripciju putem Whisper modela)
# Napravi ključ na https://console.groq.com
GROQ_API_KEY=

# Port na kojem sluša backend server (opciono, podrazumijevano 3001)
PORT=3001

# Adresa lokalnog Ollama servera (opciono, podrazumijevano http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Naziv Ollama modela koji se koristi za strukturiranje kartona i AI prijedloge
OLLAMA_MODEL=llama3.1:8b
