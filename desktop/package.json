{
  "name": "mediscribe-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Chromium desktop shell for MediScribe",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:renderer": "npm --prefix ../frontend run build && node scripts/prepare-renderer.cjs",
    "start": "electron .",
    "package": "npm run build:renderer && electron-builder"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ba.mediscribe.desktop",
    "productName": "MediScribe",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Office"
    },
    "win": {
      "target": ["nsis"]
    }
  }
}
